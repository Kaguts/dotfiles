#            Custom Functions            #
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#

# Extraire automatiquement les fichiers
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"    ;;
            *.tar.gz)    tar xzf "$1"    ;;
            *.bz2)       bunzip2 "$1"    ;;
            *.rar)       unrar x "$1"    ;;
            *.gz)        gunzip "$1"     ;;
            *.tar)       tar xvf "$1"    ;;
            *.tbz2)      tar xjf "$1"    ;;
            *.tgz)       tar xzf "$1"    ;;
            *.zip)       unzip "$1"      ;;
            *.Z)         uncompress "$1" ;;
            *.7z)        7z x "$1"       ;;
            *)           echo "Impossible d'extraire '$1'" ;;
        esac
    else
        echo "'$1' n'est pas un fichier valide"
    fi
}

# Rechercher un fichier par nom (motif shell : ff '*.yml'), avec fd si présent
ff() {
    if command -v fd >/dev/null 2>&1; then
        command fd --hidden --glob "$1"
    elif command -v fdfind >/dev/null 2>&1; then
        fdfind --hidden --glob "$1"
    else
        find . -name "$1"
    fi
}

# Rechercher un mot dans les fichiers, avec ripgrep si présent
# (ripgrep ignore ce qui est listé dans .gitignore)
fstr() {
    if command -v rg >/dev/null 2>&1; then
        rg --line-number --word-regexp --hidden --glob '!.git' -e "$1"
    else
        grep -rnw . -e "$1"
    fi
}

# Met à jour les dotfiles : récupère la dernière version du dépôt, refait les
# liens et aligne les binaires déjà installés sur les versions de tools.lock
dotup() {
    local repo
    repo=$(readlink -f "$HOME/.shell") || return 1
    "${repo%/.shell}/install.sh" --upgrade "$@"
}

# Ansible : `ap` simule (--check --diff), `apgo` applique pour de bon
ap() {
    ansible-playbook --check --diff "$@"
}
apgo() {
    ansible-playbook --diff "$@"
}

# Créer un répertoire et entrer dedans
mkcd() {
    mkdir -p "$1" && cd "$1" || return
}

# Remonter les processus les plus gourmands en CPU
topcpu() {
    ps aux --sort=-%cpu | head -n 10
}

# Obtenir l'adresse IP locale
myip() {
    # `ip` est présent partout (Debian, RHEL, WSL) ; `hostname -I` ne l'est pas
    ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") {print $(i + 1); exit}}'
}
