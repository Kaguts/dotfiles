#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#
#               Alias                    #
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#

# Alias de base
# Journal système : /var/log/messages (RHEL-like), /var/log/syslog (Debian),
# sinon journald (Debian récent, WSL avec systemd)
if [ -f /var/log/messages ]; then
    alias log="sudo tail -f /var/log/messages"
elif [ -f /var/log/syslog ]; then
    alias log="sudo tail -f /var/log/syslog"
elif command -v journalctl >/dev/null 2>&1; then
    alias log="sudo journalctl -f"
fi
alias grep="grep --color=auto"
alias addsrv="~/.shell/add_srv.sh"

#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#
#               Eza                      #
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#
# Sans eza (machine sans --tools), ls/ll gardent leur comportement standard
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --all --long --group --group-directories-first --icons --header --time-style long-iso'
    alias ll='eza --all --long --group --icons --header --time-style long-iso --sort=modified --reverse'
else
    alias ll='ls -lart --color=auto'
fi

#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#
#       Outils CLI modernes              #
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#

# Sur Debian, bat/fd sont installés sous batcat/fdfind pour éviter
# un conflit de nom avec des paquets existants. Les alias ne sont posés
# que si l'outil est présent, pour ne pas casser cat/top sur une machine nue.
if command -v bat >/dev/null 2>&1; then
    alias cat='bat --paging=never'
elif command -v batcat >/dev/null 2>&1; then
    alias bat='batcat'
    alias cat='batcat --paging=never'
fi
if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
    alias fd='fdfind'
fi
command -v btop >/dev/null 2>&1 && alias top='btop'


#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#
#               Serveurs                 #
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#

# Un alias par Host de ~/.ssh/config : `monserveur` équivaut à `ssh monserveur`.
# ~/.ssh/config est la seule liste des serveurs (`addsrv` y ajoute une entrée).
# Sont ignorés : les motifs (*, ?), les adresses IP et les noms qui
# masqueraient une commande existante. Les fichiers Include ne sont pas lus.
if [ -r ~/.ssh/config ]; then
    for _srv in $(awk 'tolower($1) == "host" { for (i = 2; i <= NF; i++) if ($i ~ /^[A-Za-z][A-Za-z0-9_-]*$/) print $i }' ~/.ssh/config); do
        command -v "$_srv" >/dev/null 2>&1 || alias "$_srv"="ssh $_srv"
    done
    unset _srv
fi

# Alias locaux en plus (RDP, connexion différente de ~/.ssh/config...) :
# fichier non versionné, chargé en dernier, donc prioritaire
[ -f ~/.shell/alias_srv ] && source ~/.shell/alias_srv

#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#
#               Docker                   #
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#

# Alias Docker (Compose : plugin v2, "docker compose" sans tiret)
if command -v docker >/dev/null 2>&1; then
    alias dstatus='docker ps --format "table{{.ID}}\t{{.Image}}\t{{.RunningFor}}\t{{.Status}}\t{{.Ports}}\t{{.Names}}"'
    alias dlogs="docker logs -f"
    alias dexec="docker exec -it"
    alias dcup="docker compose up -d"
fi

#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#
#               Git                       #
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@#
# Le reste (st, co, br, cm, amend, last, lg...) est dans git/aliases.gitconfig
if command -v git >/dev/null 2>&1; then
    alias gf='git fetch'
    alias gstash='git stash'
    alias gpop='git stash pop'
    alias girb='git rebase -i'
fi

