# Alias locaux en plus de ceux tirés de ~/.ssh/config.
#
# Chaque Host de ~/.ssh/config a déjà son alias (`monserveur` = `ssh monserveur`),
# créé par ~/.shell/alias : inutile de les répéter ici. Ce fichier sert au
# reste : RDP, options particulières, connexion différente de ~/.ssh/config.
#
# Copie-le en ~/.shell/alias_srv (non versionné, voir .gitignore). Il est
# chargé en dernier : un alias du même nom qu'un Host le remplace.

# alias bureau="xfreerdp3 /v:1.2.3.4 /u:Administrateur"
# alias bastion="ssh -A utilisateur@bastion.example.com"
